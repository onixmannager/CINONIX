# Variables de entorno necesarias en Vercel
# (Project Settings → Environment Variables)
# NO subir este archivo con valores reales a git.

# JSON completo de la cuenta de servicio de Firebase (Project Settings → Service accounts → Generate new private key)
# Pega el JSON entero en una sola línea como string.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"cinonix-3a65d", ...}

# Misma wallet para recibir USDC en ETH y BNB (son compatibles, ambas EVM)
WALLET_ETH_BNB=0xTU_DIRECCION_EVM_AQUI

# Wallet de Solana para recibir USDC (SPL)
WALLET_SOL=TU_DIRECCION_SOLANA_AQUI

# API key gratuita de https://etherscan.io/myapikey
ETHERSCAN_API_KEY=tu_api_key_etherscan

# API key gratuita de https://bscscan.com/myapikey
BSCSCAN_API_KEY=tu_api_key_bscscan

# RPC de Solana (puedes dejar el público o usar uno propio como Helius/QuickNode si da rate limit)
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Monto mínimo de USDC aceptado (deja margen sobre 19.99 por fees/redondeos)
MIN_USDC=19.5
